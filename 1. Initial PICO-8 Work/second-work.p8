pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function  _init() // begin

-- player spawn pos --
	sprite_xp = 63
	sprite_yp = 63
	
-- what sprite is being used --
	sprite = 0
	
-- the speed at which it moves --
	sprite_speed = 1
end

function _update() // update

-- arrow keys move user around --
	if 	btn(➡️) then
		sprite_xp += sprite_speed
		sprite = 0
		end
	if btn(⬅️) then
		sprite_xp -= sprite_speed
		sprite = 4
		end
	if btn(⬆️) then
		sprite_yp -= sprite_speed
		sprite = 2
		end
	if btn(⬇️) then
		sprite_yp += sprite_speed
		sprite = 6
		end
	end

function _draw() // last thing

-- any map that isn't coloured
-- is coloured by this -- 
	cls(11)
	
-- loads the map --		
	map()
	
-- loads our sprite on top of
-- the map --		
	spr(sprite ,sprite_xp, sprite_yp, 2, 2)
	
	-- gets the players
	-- position  on the map --
	
	sprite_pos = mget(flr((sprite_xp+8)/8),flr((sprite_yp+8)/8))
	
	-- if the player goes onto
	-- a road, their speed increases
	
	if (sprite_pos == 11) or
	(sprite_pos == 12) or
	(sprite_pos == 27) or
	(sprite_pos == 28) or
	(sprite_pos == 43) or
	(sprite_pos == 44) or
	(sprite_pos == 45) or
	(sprite_pos == 59) or
	(sprite_pos == 60) or
	(sprite_pos == 61) or
	(sprite_pos == 62) then	
		sprite_speed = 2
	else
		sprite_speed = 1
	end
end
