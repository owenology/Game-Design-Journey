pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function  _init() // begin
	print("hello world!")
	button=""
	sprite_xp = 63
	sprite_yp = 63
end

function _update() // update
	if 	btn(➡️) then
		sprite_xp += 1
		end
	if btn(⬅️) then
		sprite_xp -= 1
		end
	if btn(⬆️) then
		sprite_yp -= 1
		end
	if btn(⬇️) then
		sprite_yp += 1
		end
	end

function _draw() // last thing
	cls()
	spr(1,sprite_xp, sprite_yp)
	print(button)
end
